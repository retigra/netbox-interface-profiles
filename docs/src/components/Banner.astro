---
// Page banner, extended with a notice when the page belongs to the development or an older version.
import Default from '@astrojs/starlight/components/Banner.astro';

import { root, version } from '../../site.mjs';
---

<Default />

<version-notice data-root={root} data-version={version} hidden data-pagefind-ignore>
	<div class="sl-banner">
		<span></span>
		<a href={`${root}latest/`}>Go to the latest release</a>
	</div>
</version-notice>

<script>
	import { loadVersions, urlForVersion } from '../versions';

	class VersionNotice extends HTMLElement {
		async connectedCallback() {
			const { root = '/', version = 'dev' } = this.dataset;

			const data = await loadVersions(root);
			if (!data?.latest || version === 'latest' || version === data.latest) return;

			this.querySelector('span')!.textContent =
				version === 'dev'
					? 'You are viewing the documentation of the unreleased development version.'
					: `You are viewing the documentation of version ${version}.`;
			this.querySelector('a')!.textContent = `Go to the latest release (${data.latest})`;
			this.querySelector('a')!.addEventListener('click', async (event) => {
				event.preventDefault();
				location.href = await urlForVersion(root, version, 'latest');
			});
			this.hidden = false;
		}
	}

	customElements.define('version-notice', VersionNotice);
</script>

<style>
	.sl-banner {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem 1rem;
		padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
		background-color: var(--sl-color-orange-low);
		color: var(--sl-color-orange-high);
		line-height: var(--sl-line-height-headings);
		box-shadow: var(--sl-shadow-sm);
	}
	a {
		color: inherit;
		font-weight: 600;
	}
</style>
